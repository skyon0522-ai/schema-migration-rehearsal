	CREATE TYPE rehearsal.mood AS ENUM ('sad', 'ok', 'happy');
	CREATE TABLE rehearsal.items (
	    id integer PRIMARY KEY,
	    mood rehearsal.mood NOT NULL,
	    payload text NOT NULL,
